# Kalashi — Environment Configuration
# Copy this file to .env and fill in your credentials

# ── Kalshi API ──────────────────────────────────────────
# Environment: "demo" or "production"
KALSHI_ENVIRONMENT=production

# Your Kalshi API Key ID (from https://kalshi.com/account/profile)
KALSHI_KEY_ID=8418994c-d25e-46e7-ace7-0273c6b312a0
KALSHI_PRIVATE_KEY_PATH=~/.key/kalshi/key.pem

# OR paste the private key directly (overrides file path)
# KALSHI_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# ── Safety Limits ───────────────────────────────────────
# Maximum trade amount in cents (5000 = $50.00)
MAX_TRADE_AMOUNT_CENTS=5000

# Require confirmation before placing orders
REQUIRE_CONFIRMATION=true
